{
  "compilerOptions": {
    "target": "ES2022",
    // Samples are Next.js app files, so they are checked the way Next resolves them:
    // bundler, not nodenext. Under nodenext every `from "./db"` in the docs would have
    // to be written `./db.js`, which is not what a reader's own code looks like.
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"],
    // Docs samples import from "@/lib/threads" the way a reader's own code would;
    // these point that specifier at the stubs scripts/check-samples.ts writes. No
    // baseUrl: it is deprecated in TS 6, and paths resolve relative to this file.
    "paths": {
      "@/lib/threads": ["./.samples/threads.ts"],
      "@/lib/db": ["./.samples/db.ts"]
    }
  },
  "include": [".samples/**/*.ts", ".samples/**/*.tsx"]
}
