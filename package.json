    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ai": "7.0.179",
    "ai-sdk-threads": "0.1.6",
    "cspell": "10.5.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "resumable-stream": "2.2.13",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
