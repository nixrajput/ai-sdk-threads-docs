#!/bin/sh
# Pre-push gate. Runs lint + typecheck + samples check + format check + build
# before every push so unformatted, lint-broken, type-broken, sample-broken, or
# unbuildable content never reaches the remote.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass in an emergency:  git push --no-verify
set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

if [ ! -d node_modules ]; then
  echo "pre-push: node_modules missing - run 'npm install' first." >&2
  exit 1
fi

echo "pre-push: running lint + typecheck + samples check + format check + build..."
npm run lint || { echo "pre-push: lint failed - fix it or run 'npm run format'." >&2; exit 1; }
npm run types:check || { echo "pre-push: type errors - fix them before pushing." >&2; exit 1; }
npm run check:samples || { echo "pre-push: docs code samples failed - fix them before pushing." >&2; exit 1; }
npm run format:check || { echo "pre-push: formatting issues - run 'npm run format'." >&2; exit 1; }
npm run build || { echo "pre-push: build failed." >&2; exit 1; }
echo "pre-push: checks passed."
